# Candidate only: not installed, enabled or started.
# Requires separate production user/group and reviewed service/key permissions.
[Unit]
Description=Calcio Report Apple verifier Production
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=calcioappleprod
Group=calcioappleprod
WorkingDirectory=/opt/calcio-report-apple-production
EnvironmentFile=/etc/calcio-report-apple-production/service.env
ExecStart=/opt/calcio-report-node24/bin/node /opt/calcio-report-apple-production/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

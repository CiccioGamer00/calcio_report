# CANDIDATE ONLY. Do not source/start before server configuration is reviewed.
# Separate directory, process, protected env file and HTTPS hostname from Sandbox.
APPLE_DEPLOYMENT=production
APPLE_ENVIRONMENT=Production
# Numeric APP Apple ID, NOT product 6822393280. Still to obtain.
APPLE_APP_ID=
# Authorized server API key: local protected file only; never commit its contents.
APPLE_SIGNING_KEY_FILE=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# Dedicated 64-hex-character secret, distinct from Sandbox and football relay.
APPLE_VERIFIER_SECRET=
# Candidate port only: verify availability on OVH before use. Binds to loopback.
PORT=8791
